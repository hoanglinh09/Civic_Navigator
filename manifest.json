{
  "manifest_version": 3,
  "name": "Civic Navigator",
  "version": "0.1.0",
  "description": "Trợ lý hướng dẫn thủ tục trên dichvucong.gov.vn",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "debugger"
  ],
  "host_permissions": ["*://dichvucong.gov.vn/*"],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": ["*://dichvucong.gov.vn/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
